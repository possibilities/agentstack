#!/usr/bin/env node
import { spawn } from "node:child_process";
import { resolve } from "node:path";
import { fileURLToPath } from "node:url";

const hostPattern = /^[A-Za-z0-9][A-Za-z0-9.-]*$/;
const repositoryPattern = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;
const tagPattern = /^v([0-9][A-Za-z0-9.+~-]*)$/;
const shaPattern = /^[a-f0-9]{64}$/;

function usage() {
  return `Usage: scripts/install-host --remote HOST --repository OWNER/REPO --tag vVERSION --expected-sha256 SHA256 [--enable] [--confirm INSTALL-AGENTSTACK-ON-HOST]\n`;
}

function fail(message) {
  throw new Error(`install-host: ${message}`);
}

function parseArgs(argv) {
  const result = { enable: false };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "--enable") result.enable = true;
    else if (argument === "--help" || argument === "-h") result.help = true;
    else if (
      [
        "--remote",
        "--repository",
        "--tag",
        "--expected-sha256",
        "--confirm",
      ].includes(argument)
    ) {
      const value = argv[index + 1];
      if (!value || value.startsWith("--"))
        fail(`${argument} requires a value`);
      result[argument.slice(2).replaceAll("-", "_")] = value;
      index += 1;
    } else fail(`unknown argument: ${argument}`);
  }
  return result;
}

function run(command, args) {
  return new Promise((resolveRun, rejectRun) => {
    const child = spawn(command, args, { stdio: "inherit" });
    child.once("error", rejectRun);
    child.once("exit", (code, signal) => {
      if (code === 0) resolveRun();
      else
        rejectRun(
          new Error(`${command} failed (${signal ?? `exit ${String(code)}`})`),
        );
    });
  });
}

function composeRemoteProgram({
  base,
  asset,
  expectedSha256,
  tag,
  version,
  enable,
}) {
  const preferEnable = enable ? "1" : "0";
  return `set -eu
# Preserve all user state under XDG config/state; never delete engines/fx orphans.
stage=$(mktemp -d /tmp/agentstack-release.XXXXXXXX)
trap 'rm -rf -- "$stage"' EXIT HUP INT TERM
base=${base}
asset=${asset}
expected=${expectedSha256}
version=${version}
prefer_enable=${preferEnable}
curl --fail --location --proto '=https' --tlsv1.2 "$base/$asset" -o "$stage/$asset"
curl --fail --location --proto '=https' --tlsv1.2 "$base/SHA256SUMS" -o "$stage/SHA256SUMS"
curl --fail --location --proto '=https' --tlsv1.2 "$base/release-manifest.json" -o "$stage/release-manifest.json"
actual=$(sha256sum "$stage/$asset" | awk '{print $1}')
listed=$(awk -v asset="$asset" '$2 == asset { print $1 }' "$stage/SHA256SUMS")
test -n "$listed"
test "$actual" = "$listed"
test "$actual" = "$expected"
python3 - "$stage/release-manifest.json" "$asset" "$expected" '${tag}' <<'PY'
import json, sys
path, asset, expected, tag = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    manifest = json.load(handle)
assert manifest["schema"] == "agentstack.release.v1"
assert manifest["source"]["tag"] == tag
assert manifest["artifact"]["name"] == asset
assert manifest["artifact"]["sha256"] == expected
PY
prior_active=0
prior_enabled=0
if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user is-active --quiet agentstack.service 2>/dev/null; then
    prior_active=1
  fi
  if systemctl --user is-enabled --quiet agentstack.service 2>/dev/null; then
    prior_enabled=1
  fi
fi
old_daemon_pid=""
old_codex_pid=""
old_fx_pids=""
# Capture old-fx-pids before package replacement so we can assert they are gone.
if command -v agentstack >/dev/null 2>&1; then
  status_json=$(agentstack status --json 2>/dev/null || true)
  if [ -n "$status_json" ]; then
    old_daemon_pid=$(printf '%s' "$status_json" | python3 -c 'import json,sys
try:
  data=json.load(sys.stdin)
except Exception:
  data={}
control=data.get("control") if isinstance(data.get("control"), dict) else data
if not isinstance(control, dict):
  control={}
daemon=control.get("daemon") if isinstance(control.get("daemon"), dict) else {}
print(daemon.get("pid") or "")' || true)
    old_codex_pid=$(printf '%s' "$status_json" | python3 -c 'import json,sys
try:
  data=json.load(sys.stdin)
except Exception:
  data={}
control=data.get("control") if isinstance(data.get("control"), dict) else data
if not isinstance(control, dict):
  control={}
children=control.get("children") if isinstance(control.get("children"), dict) else {}
child=children.get("codex") if isinstance(children.get("codex"), dict) else {}
print(child.get("pid") or "")' || true)
    old_fx_pids=$(printf '%s' "$status_json" | python3 -c 'import json,sys
try:
  data=json.load(sys.stdin)
except Exception:
  data={}
control=data.get("control") if isinstance(data.get("control"), dict) else data
if not isinstance(control, dict):
  control={}
children=control.get("children") if isinstance(control.get("children"), dict) else {}
child=children.get("fx") if isinstance(children.get("fx"), dict) else {}
print(child.get("pid") or "")' || true)
  fi
fi
if [ -z "$old_fx_pids" ]; then
  old_fx_pids=$(ps -eo pid=,args= 2>/dev/null | awk '/\\/engines\\/fx(\\/| )|\\/engines\\/fx\\/fx( |$)/ { print $1 }' | tr '\\n' ' ' || true)
fi
state_home="\${XDG_STATE_HOME:-\$HOME/.local/state}/agentstack"
config_home="\${XDG_CONFIG_HOME:-\$HOME/.config}/agentstack"
if [ "$prior_active" = 1 ]; then
  if command -v agentstack >/dev/null 2>&1; then
    agentstack stop || true
  else
    systemctl --user stop agentstack.service || true
  fi
fi
sudo -n apt-get install -y "$stage/$asset"
installed=$(dpkg-query -W -f='\${Version}' agentstack)
test "$installed" = "$version"
cli_version=$(agentstack version)
printf '%s' "$cli_version" | grep -F "$version" >/dev/null
test ! -e /usr/lib/agentstack/current/engines/fx
want_enabled=0
want_active=0
if [ "$prefer_enable" = 1 ] || [ "$prior_enabled" = 1 ]; then
  want_enabled=1
fi
if [ "$prefer_enable" = 1 ] || [ "$prior_active" = 1 ]; then
  want_active=1
fi
if [ "$want_enabled" = 1 ]; then
  if [ "$want_active" = 1 ]; then
    agentstack enable --now
  else
    agentstack enable
  fi
elif [ "$want_active" = 1 ]; then
  agentstack start
fi
if [ "$want_active" = 1 ]; then
  status_json=$(agentstack status --json || true)
  printf '%s' "$status_json" | python3 - "$version" <<'PY'
import json, sys
version = sys.argv[1]
data = json.load(sys.stdin)
control = data.get("control") if isinstance(data.get("control"), dict) else data
assert isinstance(control, dict), data
assert (
    control.get("productVersion") == version
    or control.get("installedVersion") == version
    or control.get("runningVersion") == version
), control
components = (control.get("systemInventory") or {}).get("components") or []
ids = {component.get("id") for component in components}
assert "fx" not in ids, ids
assert set(ids) == {"daemon", "codex"}, ids
children = control.get("children") or {}
assert "fx" not in children, children
assert "codex" in children, children
assert children["codex"].get("readiness") in ("ready", "auth-required", "unknown", "unavailable"), children["codex"]
PY
fi
for pid in $old_fx_pids; do
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "install-host: old Fx process still running: $pid" >&2
    exit 1
  fi
done
# Preserve all user state: config and state directories must survive upgrade.
test -d "$config_home" || true
test -d "$state_home" || true
printf 'install-host: Preserve all user state under %s and %s\\n' "$config_home" "$state_home"
printf 'install-host: upgrade to %s complete (prior_active=%s prior_enabled=%s)\\n' "$version" "$prior_active" "$prior_enabled"`;
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) {
    process.stdout.write(usage());
    return;
  }
  if (!options.remote || !hostPattern.test(options.remote))
    fail("--remote must be a plain reviewed SSH host name");
  if (!options.repository || !repositoryPattern.test(options.repository))
    fail("--repository must be OWNER/REPO");
  const tag = options.tag?.match(tagPattern);
  if (!tag) fail("--tag must be vVERSION");
  if (!options.expected_sha256 || !shaPattern.test(options.expected_sha256))
    fail("--expected-sha256 must be a lowercase SHA-256 digest");
  const version = tag[1];
  const asset = `agentstack_${version}_amd64.deb`;
  const confirmation = `INSTALL-AGENTSTACK-ON-${options.remote}`;
  const plan = {
    remote: options.remote,
    repository: options.repository,
    tag: options.tag,
    asset,
    expectedSha256: options.expected_sha256,
    enableAfterInstall: options.enable,
    confirmationRequired: confirmation,
    upgrade: {
      stopBeforeReplace: true,
      restorePriorActiveEnabled: true,
      verifyCodexOnly: true,
      preserveUserState: true,
    },
  };
  if (options.confirm !== confirmation) {
    process.stdout.write(`${JSON.stringify(plan, null, 2)}\n`);
    process.stdout.write(
      `No installation was attempted. Re-run with --confirm ${confirmation} after reviewing this plan.\n`,
    );
    return;
  }

  const base = `https://github.com/${options.repository}/releases/download/${options.tag}`;
  const remoteProgram = composeRemoteProgram({
    base,
    asset,
    expectedSha256: options.expected_sha256,
    tag: options.tag,
    version,
    enable: options.enable,
  });
  await run("ssh", [options.remote, remoteProgram]);
  process.stdout.write(
    `Installed checksum-verified ${options.repository} ${options.tag} on ${options.remote}. GitHub attestation verification remains a separate qualification check.\n`,
  );
}

if (
  process.argv[1] &&
  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
) {
  main().catch((error) => {
    process.stderr.write(
      `${error instanceof Error ? error.message : String(error)}\n`,
    );
    process.exitCode = 1;
  });
}

export { parseArgs, composeRemoteProgram };
