{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "@agentstack/api#test": {
      "dependsOn": [
        "build",
        "@agentstack/auth#build",
        "@agentstack/bots#build",
        "@agentstack/codex#build",
        "@agentstack/owner#build"
      ],
      "cache": false
    },
    "@agentstack/docs#test": {
      "dependsOn": [
        "build",
        "@agentstack/auth#build",
        "@agentstack/bots#build",
        "@agentstack/codex#build",
        "@agentstack/owner#build"
      ],
      "cache": false
    }
  }
}
