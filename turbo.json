{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@agentstack/uix#build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "@agentstack/api#test": {
      "dependsOn": [
        "build",
        "@agentstack/auth#build",
        "@agentstack/bots#build",
        "@agentstack/roles#build",
        "@agentstack/owner#build",
        "@agentstack/workers#build",
        "@agentstack/brain#build",
        "@agentstack/wiki#build"
      ],
      "cache": false
    },
    "@agentstack/docs#test": {
      "dependsOn": [
        "build",
        "@agentstack/auth#build",
        "@agentstack/bots#build",
        "@agentstack/roles#build",
        "@agentstack/owner#build",
        "@agentstack/workers#build",
        "@agentstack/brain#build",
        "@agentstack/wiki#build"
      ],
      "cache": false
    }
  }
}
