{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@stack/ui#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "@stack/api#test": {
      "dependsOn": [
        "build",
        "@stack/auth#build",
        "@stack/signal#build",
        "@stack/infer#build",
        "@stack/bots#build",
        "@stack/roles#build",
        "@stack/serve#build",
        "@stack/worker#build",
        "@stack/hud#build",
        "@stack/brain#build",
        "@stack/xcom#build",
        "@stack/browse#build",
        "@stack/content#build"
      ],
      "cache": false
    }
  }
}
