{
  "name": "@agentstack/scrape",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": { "types": "./dist/api.d.ts", "default": "./dist/api.js" },
    "./engine": { "types": "./dist/src/api.d.ts", "default": "./dist/src/api.js" },
    "./feed": { "types": "./dist/src/feed.d.ts", "default": "./dist/src/feed.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc && node scripts/copy-assets.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@agentstack/api": "workspace:*",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.10.1",
    "markdown-it": "14.2.0",
    "turndown": "7.2.2",
    "yaml": "2.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.2",
    "@types/turndown": "5.0.6",
    "expect": "^30.2.0",
    "typescript": "^7.0.2"
  }
}
