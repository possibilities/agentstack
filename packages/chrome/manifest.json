{
  "manifest_version": 3,
  "name": "Stack",
  "version": "0.1.0",
  "description": "Share pages, links, and selections with Stack Brain, with offline delivery and recent share history.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Stack · Share to Brain",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "stack.share-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Send the current page to Stack"
    }
  }
}
