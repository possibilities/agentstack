{
  "name": "@stack/access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json",
    "./enrollment-client": { "types": "./dist/src/enrollment-client.d.ts", "default": "./dist/src/enrollment-client.js" },
    "./enrollment-protocol": { "types": "./dist/src/enrollment-protocol.d.ts", "default": "./dist/src/enrollment-protocol.js" },
    "./qr": { "types": "./dist/src/qr.d.ts", "default": "./dist/src/qr.js" },
    "./connection-client": { "types": "./dist/src/connection-client.d.ts", "default": "./dist/src/connection-client.js" }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc",
