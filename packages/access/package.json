    "node": ">=24"
  },
  "dependencies": {
    "@stack/api": "workspace:*",
    "qrcode": "1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "^8.18.1",
    "jsqr": "1.4.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
